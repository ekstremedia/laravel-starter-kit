<script setup lang="ts">
import { Head, Link, router, useForm } from '@inertiajs/vue3';
import { computed, ref, watch } from 'vue';
import { useI18n } from 'vue-i18n';
import { useConfirm } from 'primevue/useconfirm';
import ConfirmDialog from 'primevue/confirmdialog';
import CommandLayout from '@/Layouts/CommandLayout.vue';
import CommandDialog from '@/Components/Command/Dialog.vue';
import CmdButton from '@/Components/Command/Button.vue';
import Field from '@/Components/Command/Field.vue';
import Icon, { type IconName } from '@/Components/Command/Icon.vue';
import Tabs from '@/Components/Command/Tabs.vue';
// @files
import EntityFiles, { type FileRow } from '@/Components/Files/EntityFiles.vue';
// @endfiles
import { useWorkspace } from '@/composables/useWorkspace';

defineOptions({ layout: CommandLayout });

// @files
interface Model { id: number; name: string; cover_file_item_id: number | null }
// @nofiles
interface Model { id: number; name: string }
// @endfiles
// @log
interface ActivityRow { id: number; event: string | null; created_at: string | null; causer: { id: number; name: string | null } | null }
// @endlog

const props = defineProps<{
    model: Model;
// @files
    owner: { type: string; id: number };
    files: { data: FileRow[] };
    breadcrumbs: { id: number; name: string }[];
    current_folder: { id: number; name: string } | null;
// @endfiles
// @log
    activities: ActivityRow[];
// @endlog
    can_manage: boolean;
}>();

const { t, locale } = useI18n();
const { workspaceUrl } = useWorkspace();
const confirm = useConfirm();

const tabs = computed<{ key: string; label: string; icon?: IconName }[]>(() => [
    { key: 'details', label: t('{{ key }}.tab_details'), icon: 'box' },
// @files
    { key: 'files', label: t('{{ key }}.tab_files'), icon: 'disk' },
// @endfiles
]);
function initialTab(): string {
    if (typeof window !== 'undefined') {
        const tab = new URLSearchParams(window.location.search).get('tab');
// @files
        if (tab === 'files' || tab === 'details') return tab;
// @nofiles
        if (tab === 'details') return tab;
// @endfiles
    }
// @files
    return props.current_folder ? 'files' : 'details';
// @nofiles
    return 'details';
// @endfiles
}
const activeTab = ref<string>(initialTab());
watch(activeTab, (v) => {
    if (typeof window === 'undefined') return;
    const url = new URL(window.location.href);
    url.searchParams.set('tab', v);
    window.history.replaceState({}, '', url.toString());
});

// @files
function folderUrl(folderId: number | null): string {
    const base = folderId === null ? `/{{ route }}/${props.model.id}` : `/{{ route }}/${props.model.id}/folders/${folderId}`;
    return `${workspaceUrl(base)}?tab=files`;
}
function setCover(fileId: number) {
    router.patch(workspaceUrl(`/{{ route }}/${props.model.id}/cover`), { file_item_id: fileId }, { preserveScroll: true });
}
// @endfiles

const editOpen = ref(false);
const form = useForm({ name: props.model.name });
function openEdit() { form.name = props.model.name; form.clearErrors(); editOpen.value = true; }
function submitEdit() { form.put(workspaceUrl(`/{{ route }}/${props.model.id}`), { preserveScroll: true, onSuccess: () => { editOpen.value = false; } }); }
function confirmDelete() {
    confirm.require({
        group: '{{ key }}-show',
        message: t('{{ key }}.confirm_delete', { name: props.model.name }),
        header: t('{{ key }}.delete'),
        icon: 'pi pi-exclamation-triangle',
        acceptLabel: t('{{ key }}.delete'),
        rejectLabel: t('common.cancel'),
        acceptProps: { severity: 'danger' },
        accept: () => router.delete(workspaceUrl(`/{{ route }}/${props.model.id}`)),
    });
}
// @log
function activityLabel(a: ActivityRow): string {
    if (a.event === 'created') return t('{{ key }}.activity_created');
    if (a.event === 'deleted') return t('{{ key }}.activity_deleted');
    return t('{{ key }}.activity_updated');
}
function activityTime(iso: string | null): string { return iso ? new Date(iso).toLocaleString(locale.value) : ''; }
// @endlog
</script>

<template>
    <div>
        <Head :title="model.name" />
        <ConfirmDialog group="{{ key }}-show" />

        <div :style="{ display: 'flex', justifyContent: 'space-between', alignItems: 'flex-start', gap: '12px', marginBottom: '14px' }">
            <Link :href="workspaceUrl('/{{ route }}')" :style="{ fontSize: '11.5px', color: 'var(--fg-dim)', textDecoration: 'none', display: 'inline-flex', alignItems: 'center', gap: '5px' }">
                <Icon name="chevR" :size="10" :style="{ transform: 'rotate(180deg)' }" />{{ t('{{ key }}.back_to_assets') }}
            </Link>
            <div v-if="can_manage" :style="{ display: 'flex', gap: '6px' }">
                <CmdButton variant="ghost" size="sm" @click="openEdit"><template #icon><Icon name="edit" :size="12" /></template>{{ t('common.edit') }}</CmdButton>
                <CmdButton variant="danger" size="sm" @click="confirmDelete"><template #icon><Icon name="trash" :size="12" /></template>{{ t('{{ key }}.delete') }}</CmdButton>
            </div>
        </div>

        <h1 :style="{ margin: '0 0 16px', fontSize: '22px', fontWeight: 600, letterSpacing: '-0.01em', color: 'var(--fg)' }">{{ model.name }}</h1>

        <Tabs v-model="activeTab" :tabs="tabs" />

        <div v-show="activeTab === 'details'">
<!-- @log -->
            <h2 :style="{ margin: '0 0 12px', fontSize: '14px', fontWeight: 600, color: 'var(--fg)', display: 'flex', alignItems: 'center', gap: '7px' }">
                <i class="pi pi-history" :style="{ fontSize: '13px', color: 'var(--accent)' }" />{{ t('{{ key }}.activity') }}
            </h2>
            <div class="cmd-card" :style="{ padding: '6px 4px' }">
                <p v-if="!activities.length" :style="{ margin: 0, padding: '16px', fontSize: '12px', color: 'var(--fg-mute)', textAlign: 'center' }">{{ t('{{ key }}.activity_empty') }}</p>
                <div v-for="a in activities" :key="a.id" :style="{ display: 'flex', alignItems: 'center', gap: '10px', padding: '8px 14px', borderBottom: '1px solid var(--border)' }">
                    <span :style="{ flexShrink: 0, width: '24px', height: '24px', borderRadius: '50%', background: 'var(--panel2)', display: 'inline-flex', alignItems: 'center', justifyContent: 'center', color: 'var(--fg-mute)' }">
                        <Icon :name="a.event === 'created' ? 'plus' : a.event === 'deleted' ? 'trash' : 'edit'" :size="11" />
                    </span>
                    <div :style="{ flex: 1, minWidth: 0 }">
                        <span :style="{ fontSize: '12.5px', color: 'var(--fg)' }"><strong v-if="a.causer">{{ a.causer.name }}</strong> {{ activityLabel(a) }}</span>
                    </div>
                    <span class="cmd-mono" :style="{ fontSize: '10.5px', color: 'var(--fg-mute)', flexShrink: 0 }">{{ activityTime(a.created_at) }}</span>
                </div>
            </div>
<!-- @nolog -->
            <div class="cmd-card" :style="{ padding: '18px 20px' }">
                <p :style="{ margin: 0, fontSize: '13px', color: 'var(--fg-mute)' }">{{ t('{{ key }}.details_placeholder') }}</p>
            </div>
<!-- @endlog -->
        </div>

<!-- @files -->
        <div v-show="activeTab === 'files'">
            <EntityFiles
                :owner-type="owner.type" :owner-id="owner.id" :files="files"
                :breadcrumbs="breadcrumbs" :current-folder="current_folder"
                :can-manage="can_manage" :allow-set-cover="can_manage" :cover-file-item-id="model.cover_file_item_id"
                :folder-url="folderUrl" @set-cover="setCover"
            />
        </div>
<!-- @endfiles -->

        <CommandDialog v-model:visible="editOpen" :title="t('{{ key }}.edit_asset')" width="440px">
            <form @submit.prevent="submitEdit" :style="{ display: 'flex', flexDirection: 'column', gap: '12px' }">
                <Field v-model="form.name" :label="t('{{ key }}.name')" :error="form.errors.name" required autofocus />
                <button type="submit" :style="{ display: 'none' }" aria-hidden="true" />
            </form>
            <template #footer>
                <CmdButton variant="ghost" size="sm" @click="editOpen = false">{{ t('common.cancel') }}</CmdButton>
                <CmdButton variant="primary" size="sm" :loading="form.processing" @click="submitEdit"><template #icon><Icon name="disk" :size="12" /></template>{{ t('common.save') }}</CmdButton>
            </template>
        </CommandDialog>
    </div>
</template>
